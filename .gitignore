# Build artifacts
output/
__pycache__/
*.pyc
*.pyo

# Editor save-snapshots (one .bak.<timestamp> per session)
*.bak
*.bak.*

# Source rulebook PDFs — author's IP, not for distribution
*.pdf

# Generated by web/bundle.py — rebuilt on every CI run
web/data.json
web/templates/
web/images/
web/fonts/

# Local dev cruft
.DS_Store
.vscode/
.idea/
*.swp
*.swo

# Local-only docs (keep READMEs only)
*.md
!README.md
